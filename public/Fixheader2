if OLD_SEARCH in html:
html = html.replace(OLD_SEARCH, NEW_SEARCH, 1)
print(“✅ Google-style search bar applied”)
else:
# Fallback: replace by pattern
html = re.sub(
r’<!-- Row 1: Search input -->.*?<!-- Divider -->\s*<div style=“height:1px.*?</div>’,
NEW_SEARCH,
html, count=1, flags=re.DOTALL
)
print(“✅ Google-style search bar applied (fallback)”)

# ── 7. Add sync for mobileSearchInput with existing setSearch function ─────────

SYNC_JS = ‘’’
// Sync mobile search input clear button visibility
document.addEventListener(“input”, function(e) {
if (e.target && e.target.id === “mobileSearchInput”) {
var clr = document.getElementById(“mobileSearchClear”);
if (clr) clr.style.display = e.target.value ? “block” : “none”;
// also sync old searchInput for compatibility
var old = document.getElementById(“searchInput”);
if (old) old.value = e.target.value;
}
});
‘’’

last_script = html.rfind(”</script>”)
if last_script != -1:
html = html[:last_script] + SYNC_JS + “\n</script>” + html[last_script+9:]
print(“✅ Search sync JS added”)

# ── 8. Write file ──────────────────────────────────────────────────────────────

with open(path, “w”, encoding=“utf-8”) as f:
f.write(html)

print(”\n🎉 Done! Now run:”)
print(“cd /workspaces/sunscout2 && git add -A && git commit -m ‘fix: clean header, Google-style search, remove duplicates’ && git push”)
