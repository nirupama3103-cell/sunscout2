import re

path = “/workspaces/sunscout2/public/index.html”
with open(path, “r”, encoding=“utf-8”) as f:
html = f.read()

print(f”File size: {len(html)} chars”)

# ── 1. HIDE old header buttons (Plan My Day / My List / Notes) on mobile ──────

# Find the 3-button div and add a hide-mobile class to it

html = re.sub(
r’(<div style="display:flex;justify-content:center;gap:10px;margin-top:10px;flex-wrap:nowrap">)’,
r’<div class="hide-mobile" style="display:flex;justify-content:center;gap:10px;margin-top:10px;flex-wrap:nowrap">’,
html, count=1
)
print(“✅ Old buttons hidden on mobile”)

# ── 2. HIDE old search-wrap on mobile (already done in CSS but double check) ──

# Already handled by CSS: .search-wrap { display:none !important } on mobile

# ── 3. HIDE old weekend-banner on mobile (we have one in smart header) ────────

html = re.sub(
r’(<div class=“weekend-banner” id=“weekendBanner”)’,
r’<div class=“weekend-banner hide-mobile” id=“weekendBanner”’,
html, count=1
)
print(“✅ Old weekend banner hidden on mobile”)

# ── 4. HIDE old weather-banner on mobile ──────────────────────────────────────

html = re.sub(
r’(<div id=“weatherBanner” class=“weather-banner”)’,
r’<div id=“weatherBanner” class=“weather-banner hide-mobile”’,
html, count=1
)
print(“✅ Old weather banner hidden on mobile”)

# ── 5. HIDE old city-bar, age-bar, pick city/explore/age row on mobile ────────

# Add hide-mobile to the old city bar

html = re.sub(
r’(<div class=“city-bar”(?! id=“cityBarInner”))’,
r’<div class=“city-bar hide-mobile”’,
html, count=1
)
print(“✅ Old city bar hidden on mobile”)

# Hide old age bar

html = re.sub(
r’(<div class=“age-bar”)’,
r’<div class=“age-bar hide-mobile”’,
html, count=1
)
print(“✅ Old age bar hidden on mobile”)

