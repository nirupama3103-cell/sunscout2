# ── 4. JS: new functions ───────────────────────────────────────────────────────
NEW_JS = '''
// ── Smart Header JS ──
function toggleCityPanel() {
  var p = document.getElementById("cityPanel");
  var a = document.getElementById("agePanel");
  if (a) a.style.display = "none";
  if (p) p.style.display = p.style.display === "none" ? "block" : "none";
  // populate city buttons inside panel
  var inner = document.getElementById("cityBarInner");
  if (inner && p && p.style.display === "block") {
    inner.innerHTML = "";
    CITIES.forEach(function(c) {
      var btn = document.createElement("button");
      btn.className = "city-btn" + (activeCity === c ? " on" : "");
      btn.textContent = c;
      btn.onclick = function() { setCity(this, c); toggleCityPanel(); updateCityPill(); };
      inner.appendChild(btn);
    });
  }
}
function toggleAgePanel() {
  var p = document.getElementById("agePanel");
  var c = document.getElementById("cityPanel");
  if (c) c.style.display = "none";
  if (p) p.style.display = p.style.display === "none" ? "block" : "none";
}
function setAgeFromPanel(btn) {
  var age = btn.dataset.age;
  document.querySelectorAll(".age-panel-btn").forEach(function(b){ b.classList.remove("on"); });
  btn.classList.add("on");
  // also sync old age-bar
  document.querySelectorAll(".age-btn").forEach(function(b){ b.classList.toggle("on", b.dataset.age === age); });
  activeAge = age === "all" ? "all" : parseInt(age);
  var labels = {all:"Age","0":"0–2","1":"3–5","2":"6–12","3":"Teen"};
  var lbl = document.getElementById("agePillLabel");
  if (lbl) lbl.textContent = labels[age] || "Age";
  var panel = document.getElementById("agePanel");
  if (panel) panel.style.display = "none";
  showCount = getPageSize();
  if (activeCity) loadActivities();
}
function updateCityPill() {
  var lbl = document.getElementById("cityPillLabel");
  if (lbl) lbl.textContent = activeCity || "Pick City";
}
function setBigTab(btn) {
  document.querySelectorAll(".big-tab-btn").forEach(function(b){ b.classList.remove("on"); });
  btn.classList.add("on");
  // sync to original setTab logic
  var fakeBtn = document.querySelector('.tab-btn[data-tab="'+btn.dataset.tab+'"]');
  if (fakeBtn) { setTab(fakeBtn); }
  else { activeTab = btn.dataset.tab; activeAge = "all"; searchQuery = ""; showCount = getPageSize(); if (activeCity) loadActivities(); }
  // close panels
  document.getElementById("cityPanel").style.display="none";
  document.getElementById("agePanel").style.display="none";
}
function doSurprise() {
  if (!activeCity) { alert("Pick a city first! 📍"); toggleCityPanel(); return; }
  var tabs = ["free","paid","outdoor","indoor","weekend"];
  var randomTab = tabs[Math.floor(Math.random()*tabs.length)];
  var fakeBtn = document.querySelector('.big-tab-btn[data-tab="'+randomTab+'"]');
  if (fakeBtn) setBigTab(fakeBtn);
  setTimeout(function(){
    var cards = document.querySelectorAll(".card");
    if (cards.length > 0) {
      var pick = cards[Math.floor(Math.random()*cards.length)];
      pick.style.outline = "3px solid #FF9900";
      pick.scrollIntoView({behavior:"smooth",block:"center"});
      setTimeout(function(){ pick.style.outline=""; }, 2500);
    }
  }, 800);
}
// Close panels when tapping outside
document.addEventListener("click", function(e) {
  var cp = document.getElementById("cityPanel");
  var ap = document.getElementById("agePanel");
  var sh = document.getElementById("smartHeader");
  if (sh && !sh.contains(e.target)) {
    if (cp) cp.style.display = "none";
    if (ap) ap.style.display = "none";
  }
});
'''

# ── 5. Apply changes ───────────────────────────────────────────────────────────

# A. Inject CSS before </style>
if NEW_CSS.strip() not in html:
    html = html.replace("</style>", NEW_CSS + "\n</style>", 1)
    print("✅ CSS injected")

# B. Find the old weekend-banner + weather-banner + search-wrap + age-bar block
# and replace with new smart header + big tab grid
# Strategy: find the weekend-banner div and insert our new block BEFORE it,
# then hide the old elements via CSS (already done above)

weekend_match = re.search(r'<div class="weekend-banner"', html)
if weekend_match:
    insert_pos = weekend_match.start()
    html = html[:insert_pos] + NEW_HEADER_BLOCK + html[insert_pos:]
    print("✅ Smart header + big tab grid inserted before weekend-banner")
else:
    print("WARNING: weekend-banner not found — inserting after </div> of header div")
    header_end = html.find('</div>', html.find('<div class="header"')) + 6
    html = html[:header_end] + NEW_HEADER_BLOCK + html[header_end:]

# C. Inject new JS before </script> (last one)
last_script = html.rfind("</script>")
if last_script != -1:
    html = html[:last_script] + NEW_JS + "\n</script>" + html[last_script+9:]
    print("✅ JS injected")

# D. Write file
with open(path, "w", encoding="utf-8") as f:
    f.write(html)

