0CD;\n    --shadow: 0 26px 56px -30px rgba(120,60,20,.5); --shadow-sm: 0 12px 26px -18px rgba(120,60,20,.55);\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { font-family: \"Hanken Grotesk\", system-ui, sans-serif; color: var(--ink);\n    background: linear-gradient(rgba(255,249,240,.60), rgba(255,249,240,.78)), url(\"96783c95-f248-4b71-afd7-6941ed50251d\") center top / cover fixed, var(--cream);\n    -webkit-font-smoothing: antialiased; min-height: 100vh; }\n  h1,h2,h3 { font-family: \"Fredoka\", system-ui, sans-serif; font-weight: 600; line-height: 1.02; letter-spacing: -.01em; }\n  a { color: inherit; text-decoration: none; }\n  .wrap { width: min(1180px, 92vw); margin-inline: auto; }\n\n  .top { padding: 40px 0 8px; display: flex; align-items: center; gap: 12px; }\n  .logo { display: flex; align-items: center; gap: 11px; font-family: \"Fredoka\"; font-weight: 600; font-size: 21px; }\n  .sun { width: 52px; height: 52px; border-radius: 28%; background: #fff center/cover no-repeat; background-image: url(\"81b09e00-aa2d-41e0-be76-37e621361c55\"); box-shadow: 0 4px 12px -5px rgba(120,80,40,.55); flex: none; }\n  .top .tag { margin-left: auto; font-weight: 700; font-size: 13px; color: var(--soft); background: rgba(255,255,255,.92); padding: 8px 14px; border-radius: 999px; box-shadow: var(--shadow-sm); }\n  .logo { background: rgba(255,255,255,.78); padding: 6px 14px 6px 8px; border-radius: 999px; box-shadow: var(--shadow-sm); }\n\n  .intro { padding: 30px 32px 32px; max-width: 800px; margin-top: 18px;\n    background: rgba(255,252,247,.82); border: 1px solid rgba(255,255,255,.7); border-radius: 24px;\n    box-shadow: 0 20px 50px -28px rgba(120,80,160,.45); }\n  .eyebrow { font-family: \"Fredoka\"; font-weight: 600; color: var(--coral-deep); font-size: 14px; letter-spacing: .03em; text-transform: uppercase; }\n  .intro h1 { font-size: clamp(36px, 5.6vw, 60px); margin: 14px 0 16px; text-wrap: balance; }\n  .intro p { font-size: 18px; color: #5f4e3f