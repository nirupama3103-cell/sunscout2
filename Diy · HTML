px; background: #EEF2F6; }\n  .badge { position: absolute; top: 14px; left: 14px; font-family: \"Fredoka\"; font-weight: 600; font-size: 12px; color: #fff;\n    padding: 5px 12px; border-radius: 999px; }\n  .b1 { background: var(--coral); } .b2 { background: var(--mint); } .b3 { background: var(--teal); }\n\n  .opt-body { padding: 20px 22px 24px; display: flex; flex-direction: column; flex: 1; }\n  .opt-body h3 { font-size: 22px; margin-bottom: 8px; }\n  .opt-body .desc { font-size: 14.5px; color: var(--soft); font-weight: 500; line-height: 1.45; }\n  .opt-body ul { list-style: none; margin: 14px 0 18px; display: flex; flex-direction: column; gap: 7px; }\n  .opt-body li { font-size: 13.5px; font-weight: 600; color: var(--ink); display: flex; gap: 9px; align-items: flex-start; }\n  .opt-body li::before { content: \"\"; width: 7px; height: 7px; border-radius: 50%; background: var(--amber); margin-top: 6px; flex: none; }\n  .opt-cta { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }\n  .palette { display: flex; gap: 5px; }\n  .palette span { width: 16px; height: 16px; border-radius: 5px; }\n  .go { font-family: \"Fredoka\"; font-weight: 600; font-size: 14px; background: var(--ink); color: #fff; padding: 9px 16px; border-radius: 999px; }\n  .opt:hover .go { background: var(--coral); }\n\n  .foot { padding: 0 0 50px; }\n  .foot span, .foot { color: #5f4e3f; font-weight: 700; font-size: 13.5px; }\n  .foot { display: inline-block; }\n  .foot { background: rgba(255,252,247,.8); padding: 10px 18px; border-radius: 999px; box-shadow: var(--shadow-sm); }\n<\u002Fstyle>\n<\u002Fhead>\n<body>\n  <div class=\"wrap\">\n    <div class=\"top\">\n      <div class=\"logo\"><span class=\"sun\"><\u002Fspan>SunScout Kids<\u002Fdiv>\n      <span class=\"tag\">Page concept · 3 directions<\u002Fspan>\n    <\u002Fdiv>\n\n    <div class=\"intro\">\n      <span class=\"eyebrow\">Activity guide page<\u002Fspan>\n      <h1>Three directions for “Free &amp; Fun DIY Projects.”<\u002Fh1>\n      <p>Same content, three distinct personalities. Each is a fully responsive, working page — filter the activities live, then open any project to see its deep-dive guide with read-aloud kid steps and bold adult safety notes. Drop your own photos into any image slot. Pick a direction, or mix what you like.<\u002Fp>\n    <\u002Fdiv>\n\n    <div class=\"grid\">\n      <a class=\"opt\" href=\"Option 1 — Interactive Playbook.html\">\n        <div class=\"opt-vis v1\">\n          <span class=\"badge b1\">Option 1<\u002Fspan>\n          <div class=\"mock\"><div class=\"bar\"><\u002Fdiv><div class=\"tiles\"><i><\u002Fi><i><\u002Fi><i><\u002Fi><\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n        <div class=\"opt-body\">\n          <h3>The Interactive Playbook<\u002Fh3>\n          <p class=\"desc\">Immersive &amp; video-first. Cards lift in 3D and open into a full immersive drawer — looping video on one side, a giant step tracker on the other.<\u002Fp>\n          <ul>\n            <li>Energetic, tactile, modern<\u002Fli>\n            <li>Big video loops front-and-center<\u002Fli>\n            <li>Slide-up immersive project drawer<\u002Fli>\n          <\u002Ful>\n          <div class=\"opt-cta\">\n            <div class=\"palette\"><span style=\"background:#FF6B53\"><\u002Fspan><span style=\"background:#FFB23E\"><\u002Fspan><span style=\"background:#36A9C9\"><\u002Fspan><span style=\"background:#FFF4E6\"><\u002Fspan><\u002Fdiv>\n            <span class=\"go\">Open →<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fa>\n\n      <a class=\"opt\" href=\"Option 2 — Comic Book.html\">\n        <div class=\"opt-vis v2\">\n          <span class=\"badge b2\">Option 2<\u002Fspan>\n          <div class=\"mock\"><div class=\"bar\"><\u002Fdiv><div class=\"tiles\"><i><\u002Fi><i><\u002Fi><i><\u002Fi><\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n        <div class=\"opt-body\">\n          <h3>The Step-by-Step Comic Book<\u002Fh3>\n          <p class=\"desc\">Gamified &amp; kid-centric. Steps become a winding board-game path of comic panels — oversized type and buttons a 5-year-old can follow on a propped-up tablet.<\u002Fp>\n          <ul>\n            <li>Whimsical, warm, bold outlines<\u002Fli>\n            <li>Board-game step pathway<\u002Fli>\n            <li>Cozy, offline-craft feel<\u002Fli>\n          <\u002Ful>\n          <div class=\"opt-cta\">\n            <div class=\"palette\"><span style=\"background:#DB6A48\"><\u002Fspan><span style=\"background:#5FB995\"><\u002Fspan><span style=\"background:#F6B43E\"><\u002Fspan><span style=\"background:#FBEEDA\"><\u002Fspan><\u002Fdiv>\n            <span class=\"go\">Open →<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fa>\n\n      <a class=\"opt\" href=\"Option 3 — Smart Filter.html\">\n        <div class=\"opt-vis v3\">\n          <span class=\"badge b3\">Option 3<\u002Fspan>\n          <div class=\"mock\"><div class=\"side\"><i><\u002Fi><i><\u002Fi><i><\u002Fi><\u002Fdiv><div class=\"list\"><i><\u002Fi><i><\u002Fi><i><\u002Fi><\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n        <div class=\"opt-body\">\n          <h3>The Smart Filter<\u002Fh3>\n          <p class=\"desc\">Polished &amp; efficient. A sticky filter sidebar (age, type, supplies) with results that expand into clean accordions — for parents who want the right project fast.<\u002Fp>\n          <ul>\n            <li>Organized, premium, calm<\u002Fli>\n            <li>Sticky multi-filter sidebar<\u002Fli>\n            <li>Steps collapse into tidy accordions<\u002Fli>\n          <\u002Ful>\n          <div class=\"opt-cta\">\n            <div class=\"palette\"><span style=\"background:#1F2A38\"><\u002Fspan><span style=\"background:#1F9C97\"><\u002Fspan><span style=\"background:#E0714C\"><\u002Fspan><span style=\"background:#F6F0E7\"><\u002Fspan><\u002Fdiv>\n            <span class=\"go\">Open →<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fa>\n    <\u002Fdiv>\n\n    <div class=\"foot\">SunScout Kids · Pick a direction and I'll refine it, or we can blend the best parts of each.<\u002Fdiv>\n  <\u002Fdiv>\n\n  \n\n<\u002Fbody><\u002Fhtml>"
